# Control-plane image (mathapp-control-plane): job creation / exploration /
# artifact lookup. Installs ONLY core + api — the worker package and the AI
# engine (pydantic_graph/pydantic_ai/crewai) are not in this image. Engine
# isolation is thus physical (ModuleNotFound) on top of the runtime import
# guard. See docs/control_execution_split.md.
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Only the control plane's source + shared core + repo-root data. (No worker
# source — true per-image isolation.)
COPY packages/core /app/packages/core
COPY packages/api  /app/packages/api
COPY instructions  /app/instructions
COPY supabase      /app/supabase

# Editable install: resolves deps (core via path source); source stays under
# /app/packages/*/src so repo-root data dirs resolve at runtime.
RUN uv pip install --system --no-cache -e packages/api
