# Control-plane image (mathapp-control-plane): job creation / exploration /
# artifact lookup. Installs core + api + every domain package CONTROL-side
# only — the worker package and the AI engine (pydantic_graph / pydantic_ai
# / crewai) are not in this image. Each domain package's `[execution]`
# extra (which carries the LLM stack) is deliberately not pulled here, so
# engine isolation is physical (ModuleNotFound) on top of the runtime
# import guard. See docs/control_execution_split.md.
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Only the control plane's source + shared core + every domain pkg
# (control-side imports only) + repo-root data. No worker source — true
# per-image isolation.
COPY packages/core               /app/packages/core
COPY packages/api                /app/packages/api
COPY packages/math-qa            /app/packages/math-qa
COPY packages/math-conversation  /app/packages/math-conversation
COPY instructions                /app/instructions
COPY supabase                    /app/supabase

# Editable install: resolves deps (core + math pkgs via path sources). The
# api pyproject names both domain packages directly; their `[execution]`
# extras are NOT pulled (those carry pydantic_ai / crewai). Source stays
# under /app/packages/*/src so repo-root data dirs resolve at runtime.
RUN uv pip install --system --no-cache -e packages/api
