# Copy to `.env` and fill in. docker compose picks .env up automatically.

# Storage backend: `local` (filesystem on the shared docker volume), `b2`,
# or `supabase` (Postgres + Storage; in development, see
# docs/project/supabase_intro.md).
BACKEND=local

# Required for any LLM-backed jobs (math_qa).
ANTHROPIC_API_KEY=

# Required for OpenAI-backed provider helpers: audio transcription
# (`ai_platform.ai.providers.audio`) and `openai_agent`. The `openai` SDK
# ships in the worker base (both runtimes); this key is what lets it call out.
# Only needed when a domain actually invokes an OpenAI helper — the stack boots
# fine without it.
OPENAI_API_KEY=

# Logfire write token (Logfire UI → Settings → Write tokens). Required because
# `basic_agent.py` calls `logfire.configure()` at import time — without a token
# in the container, startup fails with `LogfireConfigError`. On the laptop the
# `~/.logfire/default.toml` from `logfire auth` covers this; in docker/Hetzner
# it doesn't, so set this env var.
LOGFIRE_TOKEN=

# Worker poll interval (seconds).
WORKER_INTERVAL=5

# Optional: ignore PENDING jobs older than this many seconds. Poll worker only
# (Celery/Thread deliver via broker, so stale DB rows never reach the worker).
# Unset / empty = no age limit. 7200 = 2 hours.
# WORKER_MAX_JOB_AGE_S=7200

# Optional: reclaim a RUNNING job whose worker died mid-job (no heartbeat for
# this many seconds) → PENDING for re-claim, or FAILED once max_attempts is
# used. Poll worker only. Unset / empty = reaper off. Set comfortably above
# the longest gap between a healthy job's progress updates (e.g. 900 = 15 min).
# WORKER_JOB_LEASE_TTL_S=900

# Only needed when BACKEND=b2.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=app-data

# Only needed when BACKEND=supabase. URL is `https://<project-ref>.supabase.co`.
# SUPABASE_SECRET_KEY is the modern `sb_secret_...` format (replaces the legacy
# JWT-format service_role key); RLS-bypassing — keep server-side only.
# SUPABASE_CONNECTION_STRING is the session-pooler Postgres URI from the
# dashboard (Settings → Database → Session pooler, port 5432).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=app-data
SUPABASE_CONNECTION_STRING=
