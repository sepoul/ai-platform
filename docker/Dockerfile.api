# Control-plane image (aiplatform-api): job creation / exploration /
# artifact lookup. Truly virgin — no domain source code. Domain
# control modules arrive at boot via the CodePackage catalog (the
# API-side analog of the worker's install pass; see
# ai_platform.jobs.code_package_install). The `[execution]` extras
# (LLM stacks) are still never pulled — the API is engine-free on top
# of the runtime import_guard. See docs/architecture.md §6 and
# docs/control_execution_split.md.
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Only platform source — core + api. Domain wheels arrive at boot via
# `aiplatform deploy` → CodePackage catalog → install_control_packages_for_api.
COPY packages/core               /app/packages/core
COPY packages/api                /app/packages/api
COPY instructions                /app/instructions
COPY supabase                    /app/supabase

# Editable install of the api package + core (path source). Domain
# packages are no longer pinned here — see commit history for the
# previous shape.
RUN uv pip install --system --no-cache -e packages/api
