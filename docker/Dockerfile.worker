# Virgin execution-plane image (aiplatform-worker). Ships ONLY the
# platform: core + worker base + pydantic_graph (the graph framework
# every runtime needs) + the OpenAI SDK (a framework-neutral capability
# shared by both runtimes — no otel-sdk dep, so it doesn't clash with the
# crewai pool). No domain source on disk, no runtime-specific LLM stack
# (pydantic_ai / crewai) installed — those arrive per-runtime.
#
# A domain-bound worker image (aiplatform-worker-mathqa,
# aiplatform-worker-mathconversation, …) chains on top via
# Dockerfile.worker-domain: builds the domain's wheel and pip-installs
# it INTO this image, pulling its [execution] extras. The platform
# image is published once per CI run; each domain image is one short
# Dockerfile that depends on it.
#
# Why no EXTRA arg here anymore: the previous shape baked ONE domain
# in at platform-image build time, mixing platform and domain
# concerns. The new shape keeps them strictly separated — a tenant
# deploying their own domain layers it on top of the published
# `aiplatform-worker:latest` without needing the platform repo.
#
# See docs/control_execution_split.md and ai_platform/jobs/runtimes.py.
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Only the platform's source — no real domain code. `packages/_demo`
# is the synthetic baseline domain: a single JobControl + JobExecution
# whose only purpose is to keep `docker compose up` and CI runnable
# without a deploy. It pulls in pydantic_graph but no LLM stack.
COPY packages/core   /app/packages/core
COPY packages/worker /app/packages/worker
COPY packages/_demo  /app/packages/_demo
COPY supabase        /app/supabase

# Editable install with the [demo] extra — pulls aiplatform-demo so a
# fresh boot has at least one domain registerable. Real domains
# arrive at runtime via the CodePackage catalog.
RUN uv pip install --system --no-cache -e 'packages/worker[demo]'
