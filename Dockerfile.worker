# Execution-plane image (mathapp-execution-plane). The base ships only
# pydantic_graph (the platform graph framework). EXTRA selects the runtime,
# and each runtime brings its own LLM stack so the image is slim:
#   EXTRA=default  pydantic_ai + Anthropic + Logfire (otel >=1.39) — math_qa
#   EXTRA=crewai   CrewAI[anthropic] (otel <1.35; no logfire) — math_conversation
# The two are mutually exclusive over the otel-sdk pin, so each runs as
# its own image with its own dependency tree.
# See docs/control_execution_split.md and ai_platform/jobs/runtimes.py.
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Only the execution plane's source + shared core + repo-root data. (No api
# source — true per-image isolation.)
COPY packages/core   /app/packages/core
COPY packages/worker /app/packages/worker
COPY instructions    /app/instructions
COPY supabase        /app/supabase

ARG EXTRA=default
RUN uv pip install --system --no-cache -e "packages/worker[${EXTRA}]"
