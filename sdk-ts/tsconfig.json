{
  "compilerOptions": {
    "target": "ES2022",
    // `bundler` resolution (not NodeNext) so Next's subpath types
    // (`next/server` in bff.ts) resolve as they do in Next's own tsconfig.
    // ESM correctness comes from authoring explicit `.js` extensions on
    // relative imports (tsc emits specifiers verbatim) — guarded by the
    // Node-resolution smoke check in CI, not by NodeNext's typecheck.
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
